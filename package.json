{
  "name": "unisol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Modular Cloudflare Worker tunnel gateway with WS/XHTTP transports and pluggable outbound policy.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "esbuild src/index.js --bundle --format=esm --platform=browser --target=es2022 --external:cloudflare:sockets --outfile=dist/_worker.js",
    "cf:dry-run": "wrangler deploy --dry-run --outdir dist/wrangler",
    "check": "npm test && npm run build && npm run cf:dry-run"
  },
  "devDependencies": {
    "esbuild": "0.25.9",
    "wrangler": "4.127.1"
  }
}
